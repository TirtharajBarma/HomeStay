# ========================================================
# StayRide v2.0 - Server Environment Example
# ========================================================

# 1. Server Configuration
PORT=5050
NODE_ENV=production

# 2. Database Multi-Tenant Setup (Production -> 'production', Demo -> 'test')
MONGODB_URI=mongodb+srv://<username>:<password>@cluster0.abcde.mongodb.net/?appName=Cluster0
MONGODB_DATABASE=production
MONGODB_DATABASE_PREVIEW=preview
ALLOW_LOCAL_PRODUCTION_DB=false

# 3. Demo Access Toggle (Enables demo@stayride.in testing on Vercel without touching prod data)
DEMO_ENABLED=true
LEGACY_API_ENABLED=false

# 4. Security & CORS Origins (Deployed Vercel Apps + Localhost Dev Ports)
CORS_ORIGIN=https://home-stay-admin.vercel.app,https://home-stay-p5rg.vercel.app,https://admin.stayride.in,https://stayride.in,http://localhost:3000,http://localhost:3001,http://localhost:3002,http://localhost:3003,http://127.0.0.1:3000,http://127.0.0.1:3001,http://127.0.0.1:3002,http://127.0.0.1:3003,http://localhost:5500,http://localhost:5501
GUEST_WEB_URL=https://home-stay-p5rg.vercel.app
PUBLIC_API_URL=https://home-stay-ten.vercel.app

# 5. Internal JWT Security (Platform Auth & Token Verification)
JWT_SECRET=your_super_secret_64_character_random_hex_string_here
JWT_EXPIRES_IN=15m

# 6. Clerk Authentication (Production Mobile & Web Host/Driver Auth)
CLERK_PUBLISHABLE_KEY=pk_test_...
CLERK_SECRET_KEY=sk_test_...
CLERK_WEBHOOK_SIGNING_SECRET=whsec_...

# 7. Scheduled Jobs (set a unique random value in the deployment environment)
CRON_SECRET=generate-a-unique-random-secret

# 8. Google reCAPTCHA v3 (required for anonymous web forms in production)
RECAPTCHA_SECRET_KEY=replace-with-google-secret-key
RECAPTCHA_ALLOWED_HOSTNAMES=replace-with-your-exact-production-hostnames
RECAPTCHA_MIN_SCORE=0.5

# 9. Payment Gateway (disabled until a real provider account is approved and configured)
PAYMENT_GATEWAY_MODE=disabled
RAZORPAY_KEY_ID=replace-with-live-key-id
RAZORPAY_KEY_SECRET=replace-with-live-key-secret
RAZORPAY_WEBHOOK_SECRET=replace-with-webhook-signing-secret

# 10. WhatsApp Cloud API (off until a Meta business number, token, and approved templates exist)
WHATSAPP_DISPATCH_MODE=disabled
WHATSAPP_PHONE_NUMBER_ID=replace-with-phone-number-id
WHATSAPP_ACCESS_TOKEN=replace-with-permanent-system-user-token
WHATSAPP_API_VERSION=v26.0
# Add WHATSAPP_TPL_<EVENT>=approved-template-name for each message used in production.
# Events: ASK_CAB, NEW_REQUEST, QUOTE_ACCEPTED_DRIVER, QUOTE_ACCEPTED_GUEST,
# ADVANCE_PAID_GUEST, ADVANCE_PAID_DRIVER, ADVANCE_EXPIRED_GUEST, QUOTE_COUNTER,
# TRIP_ASSIGNED_DRIVER, TRIP_CANCELLED_GUEST, REFUND_GUEST, COMPLETION_REMINDER_DRIVER,
# BIDDING_TIMEOUT_OWNER, DRIVER_WELCOME, PAYOUT_SETTLED_DRIVER, PAYOUT_REJECTED_DRIVER,
# VEHICLE_UPDATED_GUEST

# 11. Expo Push Notifications
PUSH_DISABLED=false

# 12. Photo CDN Storage (Cloudinary - set to 'disabled' until keys are added)
CLOUDINARY_CLOUD_NAME=disabled
CLOUDINARY_API_KEY=disabled
CLOUDINARY_API_SECRET=disabled

# 13. Email Notifications (SMTP - Resend sandbox sender until custom domain is verified)
SMTP_HOST=smtp.resend.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=resend
SMTP_PASS=re_...
SMTP_FROM="StayRide" <onboarding@resend.dev>

# 14. Centralized Telemetry (Axiom / Better Stack - set to 'disabled' for standard Vercel console logs)
AXIOM_TOKEN=disabled
AXIOM_DATASET=stayride-api
LOGTAIL_SOURCE_TOKEN=disabled
