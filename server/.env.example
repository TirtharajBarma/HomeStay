# ========================================================
# StayRide v2.0 - Server Environment Example
# ========================================================

PORT=5050
NODE_ENV=production

MONGODB_URI=mongodb+srv://<username>:<password>@cluster0.abcde.mongodb.net/?appName=Cluster0

# Browser origins allowed by CORS (comma separated, exact match, no wildcards). Add the admin web app and
# guest web page origins. GUEST_WEB_URL's origin is always allowed; localhost/127.0.0.1 only when not on Vercel.
CORS_ORIGIN=https://admin.stayride.in,https://stayride.in

JWT_SECRET=
JWT_EXPIRES_IN=15m

GOOGLE_CLIENT_ID=

CLERK_PUBLISHABLE_KEY=pk_test_...
CLERK_SECRET_KEY=sk_test_...
CLERK_WEBHOOK_SIGNING_SECRET=whsec_...
# Public site hosting the guest cab-request page (client-side app), used to build secure guest links
GUEST_WEB_URL=https://stayride.in

# Indian Payment Gateway (Razorpay Payment Links). simulation = off: advances are recorded by the admin.
# razorpay = on: a payment link is sent to the guest and the webhook records the payment.
# Webhook URL to set in the Razorpay dashboard: https://<your-api>/v1/webhooks/razorpay
# (event: payment_link.paid). Use test keys (rzp_test_...) first; test mode is free.
PAYMENT_GATEWAY_MODE=simulation
RAZORPAY_KEY_ID=rzp_live_...
RAZORPAY_KEY_SECRET=...
RAZORPAY_WEBHOOK_SECRET=...

# WhatsApp Dispatch Configuration
WHATSAPP_DISPATCH_MODE=native_link
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_ACCESS_TOKEN=

SUPER_ADMIN_EMAIL=admin@stayride.in
DEFAULT_ADVANCE_AMOUNT=500

# Database name used by the API (all StayRide + admin data). Demo data always lives in "test".
MONGODB_DATABASE=production
# Vercel preview deployments never use "production": they use this (default "preview").
MONGODB_DATABASE_PREVIEW=preview
# Outside Vercel the server and scripts refuse the "production" database unless this is true.
ALLOW_LOCAL_PRODUCTION_DB=false
# Shared demo account (demo@stayride.in / demo123). Off on Vercel/production unless set to true.
DEMO_ENABLED=false
# Old /api/v1 guest-website API (public listings/bookings/drivers). Keep false while client-side is suspended.
LEGACY_API_ENABLED=false
# Sample-data seeding: local/dev databases only.
ALLOW_SEED=false
SEED_PASSWORD=

# WhatsApp via Meta Cloud API (free to set up). Leave WHATSAPP_DISPATCH_MODE=native_link to keep sending OFF.
# Set it to cloud_api once PHONE_NUMBER_ID and ACCESS_TOKEN above are filled in.
# Business-initiated messages need approved templates: WHATSAPP_TPL_<EVENT>=<template name>, events:
#   ASK_CAB, NEW_REQUEST, QUOTE_ACCEPTED_DRIVER, QUOTE_ACCEPTED_GUEST, ADVANCE_PAID_GUEST,
#   ADVANCE_PAID_DRIVER, TRIP_ASSIGNED_DRIVER (variables are listed in src/stayride/messages.ts).
# Without a template name, plain text is sent (works only inside the 24h reply window / test number).
# Template language, drivers per WhatsApp broadcast, payment window, own-fleet fee, nearby radius and
# all booking limits are set by the admin in the admin app (Platform settings → Operations settings).

# Room calendar sync (Airbnb / Booking.com iCal)
# Public base URL of this API, used in the calendar links shown to owners (e.g. https://api.stayride.in).
PUBLIC_API_URL=
# Secret for the scheduled sync endpoint GET /v1/cron/ical-sync (Authorization: Bearer <secret>).
# Call it every 15-60 minutes from any scheduler (e.g. cron-job.org, free).
CRON_SECRET=
