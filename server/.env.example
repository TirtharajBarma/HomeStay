# ========================================================
# StayRide v2.0 - Server Environment Example
# ========================================================

PORT=5050
NODE_ENV=production

MONGODB_URI=mongodb+srv://<username>:<password>@cluster0.abcde.mongodb.net/?appName=Cluster0

CORS_ORIGIN=http://localhost:3000,http://localhost:3001,http://localhost:3002,http://localhost:3003,http://127.0.0.1:3000,http://127.0.0.1:3001,http://127.0.0.1:3002,http://127.0.0.1:3003

JWT_SECRET=
JWT_EXPIRES_IN=15m

GOOGLE_CLIENT_ID=

CLERK_PUBLISHABLE_KEY=pk_test_...
CLERK_SECRET_KEY=sk_test_...
CLERK_WEBHOOK_SIGNING_SECRET=whsec_...
# Public site hosting the guest cab-request page (client-side app), used to build secure guest links
GUEST_WEB_URL=https://stayride.in

# Indian Payment Gateway (Razorpay)
PAYMENT_GATEWAY_MODE=simulation
RAZORPAY_KEY_ID=rzp_live_...
RAZORPAY_KEY_SECRET=...
RAZORPAY_WEBHOOK_SECRET=...

# WhatsApp Dispatch Configuration
WHATSAPP_DISPATCH_MODE=native_link
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_ACCESS_TOKEN=

SUPER_ADMIN_EMAIL=admin@stayride.in
DEFAULT_ADVANCE_AMOUNT=500
