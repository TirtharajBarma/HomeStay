{
  "version": 2,
  "crons": [
    {
      "path": "/api/v1/stayride/cron/cab-cycle",
      "schedule": "0 0 * * *"
    },
    {
      "path": "/api/v1/stayride/cron/ical-sync",
      "schedule": "0 12 * * *"
    }
  ],
  "rewrites": [
    {
      "source": "/(.*)",
      "destination": "/api"
    }
  ]
}
