# Dependencies
node_modules/
*/node_modules/
.pnp
.pnp.js

# Next.js & Build Outputs
.next/
*/.next/
out/
*/out/
dist/
*/dist/
build/
*/build/

# Vercel
.vercel/
*/.vercel/

# Environment Files (Keep secrets out of version control)
.env
.env.local
.env.development.local
.env.test.local
.env.production.local
.env.*
*.env.local
!.env.example
!*/.env.example
!**/.env.example

# Expo & Mobile
.expo/
*/.expo/
**/.expo/
web-build/
expo-env.d.ts
*/expo-env.d.ts
.metro-health-check*
.kotlin/
*.jks
*.p8
*.p12
*.key
*.mobileprovision
/ios/
/android/
*/ios/
*/android/

# Testing & Coverage
coverage/
*/coverage/

# Logs & Debug
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# TypeScript
*.tsbuildinfo
next-env.d.ts
*/next-env.d.ts

# OS & Editor files
.DS_Store
Thumbs.db
*.pem
.idea/
.vscode/
*.swp
*.swo

# Backups
backups/
*/backups/

# Miscellaneous
image