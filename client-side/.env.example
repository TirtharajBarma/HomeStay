# ========================================================
# StayRide - Client Portal Environment Example
# ========================================================

PORT=3000

# Backend API Endpoint:
# - Local development: http://localhost:5050/api/v1
# - Online Vercel backend: https://home-stay-ten.vercel.app/api/v1
NEXT_PUBLIC_API_URL=http://localhost:5050/api/v1
NEXT_PUBLIC_RECAPTCHA_SITE_KEY=replace-with-google-site-key

# Google Maps JavaScript API & Geocoding Key (Optional but recommended):
# Secure in Google Cloud Console -> APIs & Services -> Credentials:
# Restrict HTTP referrers to your domains (e.g. localhost:*, *.vercel.app/*)
# Falls back to OpenStreetMap + Leaflet if not set.
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=

# Offline / Pre-fetch Safety Fallbacks:
# (Primary values are loaded dynamically from the Admin portal & database)
NEXT_PUBLIC_SUPPORT_PHONE=+919876543210
NEXT_PUBLIC_UPI_ID=stayride@okhdfcbank
