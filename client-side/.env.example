# ========================================================
# Client Portal Environment Configuration (Template)
# ========================================================

PORT=3000

# Brand & Domain (Set your company name and domain/Vercel URL here)
NEXT_PUBLIC_APP_NAME=YourBrandName
NEXT_PUBLIC_APP_URL=https://your-domain.com
NEXT_PUBLIC_APP_DOMAIN=your-domain.com

# Support & Contact (Set your real support email and UPI ID)
NEXT_PUBLIC_SUPPORT_EMAIL=support@your-domain.com
NEXT_PUBLIC_BOOKING_EMAIL=bookings@your-domain.com
NEXT_PUBLIC_SUPPORT_PHONE=
NEXT_PUBLIC_UPI_ID=

# Backend API Endpoint:
NEXT_PUBLIC_API_URL=https://api.your-domain.com/v1

# Google Maps JavaScript API (Optional)
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=
