{
  "expo": {
    "name": "StayRide",
    "slug": "stayride",
    "scheme": "stayride",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "splash": {
      "backgroundColor": "#1E1837",
      "resizeMode": "contain"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.stayride.app",
      "infoPlist": {
        "NSAppTransportSecurity": {
          "NSAllowsArbitraryLoads": true,
          "NSAllowsLocalNetworking": true
        }
      }
    },
    "android": {
      "package": "com.stayride.app",
      "versionCode": 1,
      "adaptiveIcon": {
        "backgroundColor": "#1E1837",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "usesCleartextTraffic": true,
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "owner": "tirtharaj_barma",
    "runtimeVersion": {
      "policy": "appVersion"
    },
    "updates": {
      "url": "https://u.expo.dev/0bdb67a8-8671-40a4-93e5-925504d907ee",
      "checkAutomatically": "NEVER",
      "fallbackToCacheTimeout": 0
    },
    "extra": {
      "eas": {
        "projectId": "0bdb67a8-8671-40a4-93e5-925504d907ee"
      },
      "updateVersion": "v1.0.0",
      "updateDescription": "Initial base release",
      "updateNotes": [
        "Base release"
      ],
      "easUpdateMessage": "v1.0.0: Initial release"
    },
    "plugins": [
      "./plugins/with-ios-local-no-push",
      "expo-notifications"
    ]
  }
}
