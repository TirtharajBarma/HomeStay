{
  "expo": {
    "name": "StayRide",
    "slug": "stayride",
    "scheme": "stayride",
    "version": "1.0.1",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "splash": {
      "backgroundColor": "#1E1837",
      "resizeMode": "contain"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.stayride.app",
      "infoPlist": {
        "NSLocationWhenInUseUsageDescription": "StayRide uses your location to discover nearby drivers and coordinate passenger pickups accurately in mountain regions.",
        "NSPhotoLibraryUsageDescription": "StayRide needs access to your photos to upload homestay room and property images.",
        "NSAppTransportSecurity": {
          "NSAllowsArbitraryLoads": false,
          "NSAllowsLocalNetworking": true
        }
      }
    },
    "android": {
      "package": "com.stayride.app",
      "versionCode": 1,
      "adaptiveIcon": {
        "backgroundColor": "#1E1837",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "usesCleartextTraffic": true,
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "owner": "tirtharaj_barma",
    "runtimeVersion": "1",
    "updates": {
      "url": "https://u.expo.dev/0bdb67a8-8671-40a4-93e5-925504d907ee",
      "requestHeaders": {
        "expo-channel-name": "preview"
      },
      "checkAutomatically": "ON_LOAD",
      "fallbackToCacheTimeout": 3000
    },
    "extra": {
      "eas": {
        "projectId": "0bdb67a8-8671-40a4-93e5-925504d907ee"
      },
      "updateVersion": "v1.0.1",
      "updateDescription": "Initial OTA update verification with atomic version sync and automatic boot-time discovery",
      "updateNotes": [
        "Initial OTA update verification with atomic version sync and automatic boot-time discovery"
      ],
      "easUpdateMessage": "v1.0.1: Initial OTA update verification with atomic version sync and automatic boot-time discovery"
    },
    "plugins": [
      "./plugins/with-ios-local-no-push",
      "expo-notifications"
    ]
  }
}
