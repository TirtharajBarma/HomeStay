# Expo Configuration
EXPO_ROUTER_DISABLE_RN_NAVIGATION_CHECK=1

# Backend API URL
# Choose based on how you run the app on Windows / Mobile:
# 1. Physical Phone with Expo Go: Use your PC's local Wi-Fi IP (find via `ipconfig` on Windows or `ifconfig` on Mac)
#    Example: EXPO_PUBLIC_API_URL=http://192.168.1.100:5050/v1
# 2. Android Studio Emulator:
#    EXPO_PUBLIC_API_URL=http://10.0.2.2:5050/v1
# 3. Web browser (npx expo start --web):
EXPO_PUBLIC_API_URL=http://localhost:5050/v1

# Clerk Authentication Publishable Key (Get from https://dashboard.clerk.com)
EXPO_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_...
