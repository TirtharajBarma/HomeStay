{
  "cli": {
    "version": ">= 12.0.0",
    "appVersionSource": "remote"
  },
  "build": {
    "development": {
      "developmentClient": true,
      "distribution": "internal",
      "channel": "development",
      "env": {
        "EXPO_PUBLIC_API_URL": "http://192.168.0.123:5050/v1"
      }
    },
    "preview": {
      "distribution": "internal",
      "android": {
        "buildType": "apk"
      },
      "channel": "preview"
    },
    "testing": {
      "distribution": "internal",
      "android": {
        "buildType": "apk"
      },
      "channel": "testing",
      "env": {
        "EXPO_PUBLIC_API_URL": "https://home-stay-ten.vercel.app/v1"
      }
    },
    "production-apk": {
      "distribution": "internal",
      "android": {
        "buildType": "apk"
      },
      "channel": "production",
      "env": {
        "EXPO_PUBLIC_API_URL": "https://home-stay-ten.vercel.app/v1"
      }
    },
    "production": {
      "autoIncrement": true,
      "android": {
        "buildType": "app-bundle"
      },
      "ios": {
        "simulator": false
      },
      "channel": "production",
      "env": {
        "EXPO_PUBLIC_API_URL": "https://home-stay-ten.vercel.app/v1"
      }
    }
  },
  "submit": {
    "production": {}
  }
}
